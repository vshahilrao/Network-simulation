                      if (quizIndex + 1 < INTERVIEW_QUESTIONS.length) {
                        setQuizIndex(prev => prev + 1);
                        setSelectedAnswer(null);
                      } else {
                        setQuizFinished(true);
                        addXp(200, 150);
                      }
                    }}
                    className="px-5 py-2 bg-cyan-600 hover:bg-cyan-500 disabled:opacity-50 text-white font-medium text-xs rounded-lg transition-all"
                  >
                    {quizIndex + 1 < INTERVIEW_QUESTIONS.length ? 'Next Question' : 'Complete Quiz'}
                  </button>
                </div>
              </div>
            ) : (
              <div className="bg-slate-900 border border-slate-800 rounded-xl p-8 text-center space-y-4">
                <CheckCircle className="w-12 h-12 text-emerald-400 mx-auto" />
                <h3 className="font-bold text-xl text-white">Interview Assessment Completed</h3>
                <p className="text-xs text-slate-300">
                  Your Score: <span className="font-bold font-mono text-cyan-400 text-sm">{quizScore} / {INTERVIEW_QUESTIONS.length} Correct</span>
                </p>
                <p className="text-xs text-slate-400">+200 XP and +150 Coins added to your career profile!</p>
                
                <button
                  onClick={() => {
                    setQuizIndex(0);
                    setSelectedAnswer(null);
                    setQuizScore(0);
                    setQuizFinished(false);
                  }}
                  className="px-6 py-2 bg-cyan-600 hover:bg-cyan-500 text-white font-medium text-xs rounded-lg transition-all"
                >
                  Restart Prep Exam
                </button>
              </div>
            )}
          </div>
        )}

      </main>

      {/* ================= EXPORT SOURCE CODE MODAL ================= */}
      {isExportOpen && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-slate-900 border border-slate-800 rounded-xl max-w-3xl w-full flex flex-col max-h-[85vh] shadow-2xl">
            <div className="px-5 py-4 border-b border-slate-800 flex justify-between items-center">
              <div className="flex items-center gap-2">
                <Code className="w-5 h-5 text-cyan-400" />
                <h3 className="font-bold text-sm text-white">Export Source Code for GitHub</h3>
              </div>
              <button 
                onClick={() => setIsExportOpen(false)}
                className="p-1 hover:bg-slate-800 rounded text-slate-400 hover:text-white"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            {/* File Selector Tabs */}
            <div className="flex border-b border-slate-800 bg-slate-950 px-4 pt-2 gap-2 text-xs font-mono">
              {['App.jsx', 'package.json', 'README.md'].map(fileName => (
                <button
                  key={fileName}
                  onClick={() => setSelectedFileToExport(fileName)}
                  className={`px-3 py-1.5 rounded-t border-t border-x transition-all ${
                    selectedFileToExport === fileName 
                      ? 'bg-slate-900 border-slate-800 text-cyan-400 font-bold' 
                      : 'border-transparent text-slate-400 hover:text-slate-200'
                  }`}
                >
                  {fileName}
                </button>
              ))}
            </div>

            {/* File Content Preview */}
            <div className="flex-1 p-4 overflow-y-auto bg-slate-950 font-mono text-xs text-slate-300">
              <pre className="whitespace-pre-wrap leading-relaxed">
                {selectedFileToExport === 'package.json' ? PACKAGE_JSON_CODE :
                 selectedFileToExport === 'README.md' ? README_MD_CODE :
                 `// Insert App.jsx full source code here or copy directly`}
              </pre>
            </div>

            <div className="p-4 border-t border-slate-800 bg-slate-900 flex justify-between items-center">
              <span className="text-xs text-slate-400">Copy this code into your repository folder.</span>
              <button
                onClick={() => {
                  const textToCopy = selectedFileToExport === 'package.json' ? PACKAGE_JSON_CODE : README_MD_CODE;
                  navigator.clipboard.writeText(textToCopy);
                  setCopySuccess(true);
                  setTimeout(() => setCopySuccess(false), 2000);
                }}
                className="px-4 py-2 bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-medium rounded-lg transition-all flex items-center gap-2"
              >
                {copySuccess ? <Check className="w-4 h-4 text-emerald-300" /> : <Copy className="w-4 h-4" />}
                <span>{copySuccess ? 'Copied to Clipboard!' : 'Copy Selected File'}</span>
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ================= FOOTER ================= */}
      <footer className="bg-slate-900 border-t border-slate-800 px-6 py-3 text-center text-[11px] text-slate-500 flex flex-col sm:flex-row justify-between items-center gap-2">
        <span>NETOPS: Enterprise Network & Cyber Defense Simulator</span>
        <span className="font-mono">Simulated Devices & Topology Engine v2.4</span>
      </footer>

    </div>
  );
}
